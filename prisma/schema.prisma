generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  KITCHEN_STAFF
  DELIVERY_STAFF
  RESIDENT
}

enum MealType {
  LUNCH
  DINNER
}

enum BookingStatus {
  BOOKED
  SKIPPED
  CANCELLED
  EXPIRED
}

enum MealStatus {
  BOOKED
  PREPARING
  PACKED
  ASSIGNED
  DISPATCHED
  DELIVERED
  CONFIRMED
  DISPUTED
  INVESTIGATING
  RESOLVED
  CANCELLED
}

enum DeliveryBatchStatus {
  CREATED
  ASSIGNED
  DISPATCHED
  COMPLETED
}

enum ComplaintType {
  MISSING_MEAL
  WRONG_MEAL
  DAMAGED_PACKAGING
  LATE_DELIVERY
  QUALITY
  OTHER
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  INVESTIGATING
  RESOLVED
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  name               String?
  passwordHash       String
  role               Role            @default(RESIDENT)
  refreshTokenHash   String?
  isActive           Boolean         @default(true)
  organizationId     String?
  organization       Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  propertyId         String?
  property           Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  resident           Resident?
  deliveries         DeliveryBatch[] @relation("StaffDeliveries")
  mealEvents         MealEvent[]
  complaintsAssigned Complaint[]     @relation("StaffComplaints")

  @@index([organizationId])
  @@index([propertyId])
}

model Organization {
  id         String     @id @default(uuid())
  name       String
  properties Property[]
  users      User[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Property {
  id              String          @id @default(uuid())
  name            String
  address         String?
  city            String?
  timezone        String?
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users           User[]
  rooms           Room[]
  residents       Resident[]
  menus           Menu[]
  bookings        Booking[]
  deliveryBatches DeliveryBatch[]
  meals           Meal[]
  complaints      Complaint[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
}

model Room {
  id         String     @id @default(uuid())
  roomNumber String
  floor      String?
  capacity   Int        @default(2)
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  residents  Resident[]
  meals      Meal[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([propertyId])
}

enum ResidentStatus {
  ACTIVE
  INACTIVE
}

enum MealPlan {
  STANDARD
  LUNCH_ONLY
  DINNER_ONLY
  CUSTOM
}

model Resident {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId   String
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId       String?
  room         Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  residentCode String?
  mealPlan     MealPlan       @default(STANDARD)
  status       ResidentStatus @default(ACTIVE)
  joinedAt     DateTime       @default(now())
  leftAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookings     Booking[]
  meals        Meal[]
  complaints   Complaint[]

  @@index([propertyId])
  @@index([roomId])
}

model Menu {
  id          String    @id @default(uuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  type        MealType
  title       String
  description String?
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([propertyId, date, type])
  @@index([propertyId])
}

model Booking {
  id         String        @id @default(uuid())
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  menuId     String
  menu       Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  residentId String
  resident   Resident      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  status     BookingStatus @default(BOOKED)
  meal       Meal?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([menuId, residentId])
  @@index([propertyId])
  @@index([menuId])
  @@index([residentId])
}

model DeliveryBatch {
  id           String              @id @default(uuid())
  propertyId   String
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?               @relation("StaffDeliveries", fields: [assignedToId], references: [id], onDelete: SetNull)
  date         DateTime            @db.Date
  type         MealType
  status       DeliveryBatchStatus @default(CREATED)
  meals        Meal[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([propertyId])
  @@index([assignedToId])
}

model Meal {
  id              String         @id @default(uuid())
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingId       String         @unique
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  residentId      String
  resident        Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  roomId          String?
  room            Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  deliveryBatchId String?
  deliveryBatch   DeliveryBatch? @relation(fields: [deliveryBatchId], references: [id], onDelete: SetNull)
  status          MealStatus     @default(BOOKED)
  qrToken         String         @unique
  events          MealEvent[]
  complaints      Complaint[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([propertyId])
  @@index([residentId])
  @@index([deliveryBatchId])
  @@index([qrToken])
}

model MealEvent {
  id        String     @id @default(uuid())
  mealId    String
  meal      Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  status    MealStatus
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes     String?
  createdAt DateTime   @default(now())

  @@index([mealId])
  @@index([userId])
}

model Complaint {
  id              String          @id @default(uuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  mealId          String
  meal            Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  residentId      String
  resident        Resident        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type            ComplaintType
  status          ComplaintStatus @default(OPEN)
  description     String
  resolutionNotes String?
  assignedToId    String?
  assignedTo      User?           @relation("StaffComplaints", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([propertyId])
  @@index([mealId])
  @@index([residentId])
  @@index([assignedToId])
}
