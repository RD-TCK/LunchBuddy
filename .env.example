# Database Configuration
POSTGRES_USER=mealflow_user
POSTGRES_PASSWORD=mealflow_password
POSTGRES_DB=mealflow
# Supabase Transaction Pooler URL (for Prisma Client)
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Direct Connection URL (for Prisma Migrations)
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth
JWT_SECRET=super-secret-jwt-key-change-me
JWT_EXPIRES_IN=1d

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
